generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: ADMIN | INTERNAL | PORTAL
model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  role             String         @default("PORTAL")
  phone            String?
  address          String?
  state            String?
  gstin            String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime       @default(now())
  subscriptions    Subscription[]
  invoices         Invoice[]
}

model Tax {
  id        String             @id @default(cuid())
  name      String
  percent   Float
  products  Product[]
  lines     SubscriptionLine[]
  createdAt DateTime           @default(now())
}

// type: SERVICE | GOODS
model Product {
  id                String             @id @default(cuid())
  name              String
  type              String             @default("SERVICE")
  salesPrice        Float
  costPrice         Float
  notes             String?
  active            Boolean            @default(true)
  taxId             String?
  tax               Tax?               @relation(fields: [taxId], references: [id])
  variants          ProductVariant[]
  subscriptionLines SubscriptionLine[]
  templateLines     TemplateLine[]
  discounts         DiscountProduct[]
  createdAt         DateTime           @default(now())
}

model ProductVariant {
  id         String             @id @default(cuid())
  productId  String
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Float              @default(0)
  lines      SubscriptionLine[]
}

// billingPeriod: DAILY | WEEKLY | MONTHLY | YEARLY
model RecurringPlan {
  id            String              @id @default(cuid())
  name          String
  price         Float
  billingPeriod String
  minQuantity   Int                 @default(1)
  startDate     DateTime
  endDate       DateTime?
  autoClose     Boolean             @default(false)
  closable      Boolean             @default(true)
  pausable      Boolean             @default(false)
  renewable     Boolean             @default(true)
  subscriptions Subscription[]
  templates     QuotationTemplate[]
  createdAt     DateTime            @default(now())
}

// type: FIXED | PERCENT ; appliesTo: PRODUCT | SUBSCRIPTION
model Discount {
  id            String            @id @default(cuid())
  name          String
  type          String
  value         Float
  minPurchase   Float             @default(0)
  minQuantity   Int               @default(1)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int               @default(0)
  appliesTo     String            @default("SUBSCRIPTION")
  products      DiscountProduct[]
  subscriptions Subscription[]
  createdAt     DateTime          @default(now())
}

model DiscountProduct {
  discountId String
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

model QuotationTemplate {
  id           String         @id @default(cuid())
  name         String
  validityDays Int
  planId       String
  plan         RecurringPlan  @relation(fields: [planId], references: [id])
  lines        TemplateLine[]
  createdAt    DateTime       @default(now())
}

model TemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  quantity   Int               @default(1)
}

// status: DRAFT | QUOTATION | CONFIRMED | ACTIVE | PAUSED | CLOSED
model Subscription {
  id              String             @id @default(cuid())
  number          String             @unique
  customerId      String
  customer        User               @relation(fields: [customerId], references: [id])
  planId          String
  plan            RecurringPlan      @relation(fields: [planId], references: [id])
  startDate       DateTime
  expirationDate  DateTime?
  paymentTerms    String             @default("Immediate")
  status          String             @default("DRAFT")
  nextBillingDate DateTime?
  quoteValidUntil DateTime?
  discountId      String?
  discount        Discount?          @relation(fields: [discountId], references: [id])
  lines           SubscriptionLine[]
  invoices        Invoice[]
  logs            AuditLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id])
  quantity       Int
  unitPrice      Float
  amount         Float
}

// status: DRAFT | CONFIRMED | PAID | CANCELLED
model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  subtotal       Float
  discountTotal  Float         @default(0)
  taxTotal       Float
  total          Float
  amountPaid     Float         @default(0)
  status         String        @default("DRAFT")
  lines          InvoiceLine[]
  payments       Payment[]
  createdAt      DateTime      @default(now())

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  taxPercent  Float   @default(0)
  discount    Float   @default(0)
  amount      Float
}

// method: UPI | CARD | BANK | CASH
model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  method      String
  amount      Float
  paymentDate DateTime
  note        String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  entity         String
  entityId       String
  action         String
  details        String?
  actorId        String?
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime      @default(now())
}
